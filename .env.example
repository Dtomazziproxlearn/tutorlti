# Copy this file to .env for local development. On Render, set these in the
# service's Environment tab instead (render.yaml prompts for the secrets).

ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
PORT=3000

# Postgres. On Render this is filled in automatically from the database.
# Locally, paste the database's *External* connection URL from Render.
DATABASE_URL=postgres://user:password@host:5432/tutor

# ---- LTI / Canvas ----
# Client ID of the Canvas Developer Key (the long number in the Details column).
# For several Canvas instances, list them comma-separated in LTI_CLIENT_IDS.
LTI_CLIENT_ID=
# Optional allowlist of deployment IDs (comma-separated). Blank = allow all.
LTI_DEPLOYMENT_IDS=
# Tool private key, from `npm run generate-key`.
LTI_PRIVATE_KEY=
# The tool's public URL. On Render this defaults to RENDER_EXTERNAL_URL.
# Set it if you use a custom domain, e.g. https://tutor.proxlearn.com
PUBLIC_BASE_URL=

# Canvas Cloud production defaults. Change only for beta/test or self-hosted Canvas.
# Beta: https://canvas.beta.instructure.com / https://sso.beta.canvaslms.com/...
# Test: https://canvas.test.instructure.com / https://sso.test.canvaslms.com/...
LTI_ISSUER=https://canvas.instructure.com
LTI_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect
LTI_JWKS_URL=https://sso.canvaslms.com/api/lti/security/jwks

# ---- Canvas API (lets the tutor see the course's modules) ----
# Token from a dedicated Canvas service account (see README, "Course modules").
# CANVAS_API_BASE_URL is your Canvas address. For Canvas beta testing use the
# beta address, e.g. https://district.beta.instructure.com
CANVAS_API_BASE_URL=
CANVAS_API_TOKEN=
# Several Canvas instances instead: comma-separated "url=token" pairs.
# CANVAS_API_TOKENS=https://a.instructure.com=token1,https://b.instructure.com=token2
# Minutes before a course's saved module list is re-read from Canvas
CANVAS_OUTLINE_TTL_MINUTES=60

# Max tokens for each tutor reply (including planning before a lookup)
MAX_REPLY_TOKENS=2048

# Sites allowed to show the tutor in an iframe (space-separated). Add any
# district custom Canvas domains, e.g. https://canvas.district.org
FRAME_ANCESTORS=https://*.instructure.com https://*.canvaslms.com

# ---- Limits and data ----
# Max chat messages per student per 15 minutes
RATE_LIMIT_PER_15_MIN=60
# How long a Canvas launch stays signed in
SESSION_HOURS=8
# Reopen a student's last chat if they used it within this many hours
RESUME_HOURS=12
# Delete chats older than this many days; 0 = keep forever
RETENTION_DAYS=365
